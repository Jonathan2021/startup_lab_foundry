# Copy to .env.dev for the product-local Compose development stack.
# Use a generated URL-safe password; never commit the populated file.
POSTGRES_USER=foundry
POSTGRES_PASSWORD=foundry
POSTGRES_DB=foundry
FOUNDRY_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
FOUNDRY_SQL_ECHO=false
FOUNDRY_DEBUG=true

# Keep SQL echo separate from DEBUG: bound values may contain sensitive data.
FOUNDRY_SQL_ECHO=false
